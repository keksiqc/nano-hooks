{
  "name": "nano-hooks",
  "version": "0.3.0",
  "description": "A tiny git hooks manager with zero dependencies",
  "keywords": [],
  "homepage": "https://github.com/keksiqc/nano-hooks#readme",
  "bugs": "https://github.com/keksiqc/nano-hooks/issues",
  "license": "MIT",
  "author": "Keksi <hello@keksi.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keksiqc/nano-hooks.git"
  },
  "bin": {
    "nano-hooks": "./src/cli.js"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "fmt": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix && oxfmt",
    "test": "vitest run",
    "release": "pnpm run lint:fix && pnpm run test && bumpp",
    "prepare": "nano-hooks"
  },
  "devDependencies": {
    "bumpp": "^12.3.0",
    "nano-hooks": "link:",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22 || >=24"
  },
  "packageManager": "pnpm@12.16.1",
  "nano-hooks": {
    "staged": {
      "*": "pnpm run fmt",
      "*.{js,jsx,ts,tsx,mjs,cjs}": "pnpm run lint"
    }
  }
}
