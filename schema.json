{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by pnpm schema.",
  "title": "nano-hooks configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "pattern": "\\S",
      "description": "Schema path or URL for editor validation."
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowEmpty": {
          "type": "boolean",
          "description": "Allow a commit that becomes empty after running staged tasks."
        },
        "bail": {
          "type": "boolean",
          "description": "Stop running staged tasks after the first command fails."
        },
        "parallel": {
          "type": "boolean",
          "description": "Run tasks for different staged patterns concurrently."
        },
        "restage": {
          "type": "boolean",
          "description": "Stage the changes made by staged tasks."
        },
        "preserveUnused": {
          "description": "Keep all unused managed hooks, or keep the listed hooks.",
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {
                "enum": [
                  "applypatch-msg",
                  "pre-applypatch",
                  "post-applypatch",
                  "pre-commit",
                  "pre-merge-commit",
                  "prepare-commit-msg",
                  "commit-msg",
                  "post-commit",
                  "pre-rebase",
                  "post-checkout",
                  "post-merge",
                  "pre-push",
                  "reference-transaction",
                  "pre-auto-gc",
                  "post-rewrite",
                  "sendemail-validate",
                  "fsmonitor-watchman",
                  "post-index-change"
                ]
              }
            }
          ]
        }
      }
    },
    "hooks": {
      "type": "object",
      "description": "Commands to run for each Git hook.",
      "additionalProperties": false,
      "properties": {
        "applypatch-msg": {
          "$ref": "#/$defs/commandList"
        },
        "pre-applypatch": {
          "$ref": "#/$defs/commandList"
        },
        "post-applypatch": {
          "$ref": "#/$defs/commandList"
        },
        "pre-commit": {
          "$ref": "#/$defs/commandList"
        },
        "pre-merge-commit": {
          "$ref": "#/$defs/commandList"
        },
        "prepare-commit-msg": {
          "$ref": "#/$defs/commandList"
        },
        "commit-msg": {
          "$ref": "#/$defs/commandList"
        },
        "post-commit": {
          "$ref": "#/$defs/commandList"
        },
        "pre-rebase": {
          "$ref": "#/$defs/commandList"
        },
        "post-checkout": {
          "$ref": "#/$defs/commandList"
        },
        "post-merge": {
          "$ref": "#/$defs/commandList"
        },
        "pre-push": {
          "$ref": "#/$defs/commandList"
        },
        "reference-transaction": {
          "$ref": "#/$defs/commandList"
        },
        "pre-auto-gc": {
          "$ref": "#/$defs/commandList"
        },
        "post-rewrite": {
          "$ref": "#/$defs/commandList"
        },
        "sendemail-validate": {
          "$ref": "#/$defs/commandList"
        },
        "fsmonitor-watchman": {
          "$ref": "#/$defs/commandList"
        },
        "post-index-change": {
          "$ref": "#/$defs/commandList"
        }
      }
    },
    "staged": {
      "type": "object",
      "description": "Commands to run on staged files matching each glob. nano-hooks checks glob syntax when loading the configuration.",
      "minProperties": 1,
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/commandList"
      }
    }
  },
  "$defs": {
    "commandList": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "\\S"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      ]
    }
  }
}
